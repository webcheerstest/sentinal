# Sentinal Honeypot - Environment Variables Template
# Copy to .env and fill in your actual values

# === REQUIRED ===

# OpenRouter API Key (for LLM responses)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Your API Key (for securing your honeypot endpoint)
# Generate a strong key: openssl rand -hex 32
MY_API_KEY=sentinal-hackathon-2026

# === OPTIONAL (defaults work) ===

# OpenRouter API Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GUVI Callback URL (for competition intelligence reporting)
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/submit-intelligence

# === RAILWAY DEPLOYMENT ===
# When deploying to Railway, set these in the Railway dashboard Variables tab
# DO NOT commit your actual .env file to git!
